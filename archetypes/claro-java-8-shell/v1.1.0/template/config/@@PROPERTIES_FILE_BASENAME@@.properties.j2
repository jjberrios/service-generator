# Plantilla de configuracion externa (jinja2) de @@PROPERTIES_FILE_BASENAME@@.properties
#
# Esta plantilla NO contiene valores de entorno ni secretos. Los valores los suministra el
# operador/entorno al desplegar; el archivo resultante se ubica FUERA del jar y se indica a la
# JVM con -Dproperties=<ruta del archivo> (applicationContext.xml: file:${properties}).
#
# Claves genericas observadas en la referencia (siempre presentes):
#   log4j.file.dir  -> ruta del archivo de configuracion de log4j (PropertyConfigurator.configure)
#   idf0/idf1       -> codigo/mensaje de respuesta funcional
#   idt1/idt2/idt3  -> codigo/mensaje de error tecnico (timeout / disponibilidad / general);
#                      los mensajes pueden contener los placeholders [RECURSO] y [DETALLE]
#   ws.ebsConsultaClavesWS.* -> servicio SOAP corporativo de descifrado de credenciales:
#                      url (WSDL/endpoint; valor del operador, nunca versionado), timeouts en ms
#                      y codigo de aplicacion registrado ante el servicio (valores de entorno)

log4j.file.dir={{ log4j_file_dir }}

idf0.codigo={{ idf0_codigo }}
idf0.mensaje={{ idf0_mensaje }}
idf1.codigo={{ idf1_codigo }}
idf1.mensaje={{ idf1_mensaje }}

idt1.codigo={{ idt1_codigo }}
idt1.mensaje={{ idt1_mensaje }}
idt2.codigo={{ idt2_codigo }}
idt2.mensaje={{ idt2_mensaje }}
idt3.codigo={{ idt3_codigo }}
idt3.mensaje={{ idt3_mensaje }}

ws.ebsConsultaClavesWS.url={{ ws_ebsconsultaclavesws_url }}
ws.ebsConsultaClavesWS.max.request.timeout={{ ws_ebsconsultaclavesws_max_request_timeout }}
ws.ebsConsultaClavesWS.max.connection.timeout={{ ws_ebsconsultaclavesws_max_connection_timeout }}
ws.ebsConsultaClavesWS.codigo.aplicacion={{ ws_ebsconsultaclavesws_codigo_aplicacion }}

# ---------------------------------------------------------------------------------------
# Claves especificas del servicio: las agrega el materializador a partir de la
# especificacion funcional (Sparx), sin duplicar las anteriores. Patrones observados:
#   ftp.<externo|interno>.{username,host,puerto,password}   (credenciales cifradas en origen)
#   ruta.temp.<proceso>                                      (directorio temporal local)
#   sftp.<proceso>.ruta.{remota,interna}.and.formatos.file.<tipo>
#   sftp.<proceso>.nombre.archivo.fecha.{ejecucion,formato.ejecucion}
#   ws.<otro-servicio>.{url,max.request.timeout,max.connection.timeout,codigo.aplicacion}
# Cada clave agregada requiere su campo publico @Value en PropertiesExterno.
# ---------------------------------------------------------------------------------------
