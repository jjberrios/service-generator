apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: __SECRET_NAME__
  namespace: __K8S_NAMESPACE__
  labels:
    app.kubernetes.io/name: __SERVICE_NAME__
    app.kubernetes.io/part-of: __K8S_PART_OF__
    app.kubernetes.io/component: secret
    app.kubernetes.io/managed-by: __K8S_MANAGED_BY__
    claro.pe/environment: __ENVIRONMENT__
    claro.pe/owner: __K8S_OWNER__
spec:
  refreshInterval: __EXTERNAL_SECRET_REFRESH_INTERVAL__
  secretStoreRef:
    name: __VAULT_SECRET_STORE_NAME__
    kind: __VAULT_SECRET_STORE_KIND__
  target:
    name: __SECRET_NAME__
    creationPolicy: Owner
  data:
    - secretKey: JWT_SECRET_KEY
      remoteRef:
        key: __VAULT_SECRET_PATH__
        property: __JWT_SECRET_PROPERTY__
    # __EXTERNAL_SECRET_ADDITIONAL_DATA__
